{
  "name": "@marianmeres/static-upload-server",
  "version": "2.0.0",
  "description": "Self-hosted static file server with an upload endpoint: per-project config, token and JWT auth, multipart POST and streamed PUT uploads, plugins, optional CDN cache headers and purge.",
  "license": "MIT",
  "author": "Marian Meres",
  "type": "module",
  "packageManager": "pnpm@12.18.0",
  "engines": {
    "node": ">=24.12"
  },
  "publishConfig": {
    "access": "public"
  },
  "main": "./dist/server.js",
  "types": "./dist/server.d.ts",
  "bin": {
    "static-upload-server": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/server.d.ts",
      "default": "./dist/server.js"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "default": "./dist/server.js"
    }
  },
  "files": [
    "dist",
    "API.md",
    "AGENTS.md"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/marianmeres/static-upload-server.git"
  },
  "bugs": {
    "url": "https://github.com/marianmeres/static-upload-server/issues"
  },
  "homepage": "https://github.com/marianmeres/static-upload-server#readme",
  "keywords": [
    "static",
    "upload",
    "file-server",
    "self-hosted",
    "cdn",
    "cli"
  ],
  "scripts": {
    "build": "pnpm run clean && tsc -p tsconfig.build.json && cp src/upload.html dist/upload.html",
    "clean": "rm -rf dist",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "format": "biome check --write .",
    "test": "node --test \"tests/**/*.test.ts\"",
    "test:watch": "node --test --watch \"tests/**/*.test.ts\"",
    "smoke": "pnpm run build && node scripts/smoke-npm.ts",
    "ci": "pnpm run typecheck && pnpm run lint && pnpm test && pnpm run smoke",
    "prepublishOnly": "pnpm run ci && pnpm run build",
    "dev": "node --watch example/main.ts",
    "example": "node --env-file=.env.example example/main.ts",
    "memcheck": "node scripts/memcheck.ts",
    "release": "npx --yes @marianmeres/release@^2.3.0 --before-bump \"pnpm run ci\"",
    "rp": "npm whoami >/dev/null && pnpm run release -y --before-push \"pnpm publish\"",
    "rpm": "npm whoami >/dev/null && pnpm run release minor -y --before-push \"pnpm publish\"",
    "docker:build": "docker compose build",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "docker:upgrade": "docker compose up -d --force-recreate --pull always",
    "docker:restart": "docker compose down && docker compose up -d --force-recreate",
    "docker:rebuild": "docker compose build && docker compose down && docker compose up -d --force-recreate",
    "docker:logs": "docker compose logs -f",
    "deploy": "bash deploy.sh"
  },
  "dependencies": {
    "@marianmeres/demino": "^2.2.0",
    "mime-types": "^3.0.2"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.8",
    "@types/mime-types": "^3.0.1",
    "@types/node": "^26.6.6",
    "typescript": "^7.0.2"
  }
}
